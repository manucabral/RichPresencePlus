{
  "name": "Web Media",
  "version": "1.0.0",
  "description": "Shows the video or song playing on any site you allow.",
  "client_id": "1567580382377803786",
  "kind": "video",
  "interval": 5,
  "entry": "main.js",
  "page": {
    "matches": ["*://*/*"],
    "extract": {
      "session": {
        "from": "session"
      },
      "player": {
        "from": "media"
      },
      "site": {
        "from": "meta",
        "name": "og:site_name"
      }
    }
  },
  "author": "manucabral",
  "color": "#19C283",
  "tags": ["video", "music"],
  "icon": "icon.webp"
}
