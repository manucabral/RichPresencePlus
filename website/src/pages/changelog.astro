---
import Shell from "../components/Shell.astro";
import { STRINGS } from "../i18n/strings";
import { Content } from "../../../docs/changelog.en.md";

const t = STRINGS.en.changelog;
---

<Shell language="en" title={`${t.title} - Rich Presence Plus`} description={t.meta} paths={{ en: "/changelog/", es: "/es/changelog/" }}>
  <article class="page wrap narrow legal"><Content /></article>
</Shell>
