{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rich Presence Plus",
  "version": "0.2.0",
  "identifier": "com.manucabral.richpresenceplus",
  "build": {
    "beforeDevCommand": { "script": "pnpm dev", "cwd": "../frontend" },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": { "script": "pnpm build", "cwd": "../frontend" },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "backgroundColor": "#08090a",
        "additionalBrowserArgs": "--disable-gpu --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection",
        "title": "Rich Presence Plus",
        "width": 950,
        "height": 650,
        "minWidth": 360,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../docs/legal/THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "publisher": "manucabral",
    "copyright": "© 2026 manucabral",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "languages": [
          "English",
          "Spanish"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/manucabral/RichPresencePlus/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "requireSignedVersion": true,
      "allowDowngrades": false
    }
  }
}
